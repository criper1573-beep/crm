# GRS AI API (скопировать значения из проекта КонтентЗавод в .env)
GRS_AI_API_KEY=
GRS_AI_API_URL=https://grsaiapi.com

# Avito Messenger API (получить в личном кабинете Авито)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Пересылка вебхука Авито ассистенту. Если любая переменная пустая — пересылки нет.
SONYA_HOOK_URL=
SONYA_HOOK_AUTH=
