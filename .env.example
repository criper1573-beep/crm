# GRS AI API (скопировать значения из проекта КонтентЗавод в .env)
GRS_AI_API_KEY=
GRS_AI_API_URL=https://grsaiapi.com

# Avito Messenger API (получить в личном кабинете Авито)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Документы лида. Пароли — те же, что у пользователей admin и sonya в /etc/nginx/.htpasswd.
# Без них эндпоинты /api/leads/{id}/files отвечают 401.
CRM_AUTH_ADMIN_PASSWORD=
CRM_AUTH_SONYA_PASSWORD=
# Каталог файлов. Пусто = data/files рядом с data/crm.db. Относительный путь считается от корня проекта.
# CRM_FILES_DIR=
# Лимит одного файла в байтах. Пусто = 52428800 (50 МБ).
# CRM_MAX_UPLOAD_BYTES=52428800
